# ===== 公開URL =====
NEXT_PUBLIC_SITE_URL=https://pl-tokyo.com
NEXT_PUBLIC_BASE_PATH=/sale

# ===== 計測（未設定でもサイトは正常に動きます） =====
# GA4 測定ID（例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA4_ID=G-G7V570DYL2
# Microsoft Clarity プロジェクトID
NEXT_PUBLIC_CLARITY_ID=yzlnivg1zn
# Meta Pixel ID（例: 123456789012345）
NEXT_PUBLIC_META_PIXEL_ID=
# Amazonアソシエイト トラッキングID（例: punchline-22）。設定すると全Amazonリンクに tag= が付きます
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# ===== 環境 =====
# ステージング・テスト環境では true（noindex になります）
NEXT_PUBLIC_NOINDEX=false
# true でブラウザのコンソールに計測イベントを表示（本番は false）
NEXT_PUBLIC_DEBUG_TRACKING=false
# export（静的書き出し・既定） / standalone（Vercel等のNode環境）
NEXT_OUTPUT=export
